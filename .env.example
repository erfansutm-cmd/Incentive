# MySQL connection settings — copy this file to `.env` and fill in real values.
DB_USER=erfan.mohamadi
DB_PASSWORD=
DB_HOST=172.21.41.75
DB_PORT=3306
DB_NAME=incentive

# ClickHouse connection settings (for future use - not active yet)
# CLICKHOUSE_HOST=clickhouse.example.com
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# Tables may be given as "table" or "schema/table" when the table lives in
# another database/schema on the same MySQL server, e.g.
#   DB_BUSINESS_ENTITIES_TABLE=other_db/business_entities
DB_CITIES_TABLE=cities
DB_BUSINESS_ENTITIES_TABLE=business_entities
# Per-city plan mapping behind the Cities slide-down panel
DB_CITY_PLAN_MAPPING_TABLE=incentive/incentive_city_plan_mapping
# Incentive type lookup (id -> name) for plan mappings and the Decision Matrix
DB_INCENTIVE_TYPE_TABLE=mafsho/incentive_type
# Decision Matrix rows and the distinct city_group lookup
DB_DECISION_MATRIX_TABLE=incentive/incentive_decision_matrix
DB_ACTIVE_CITY_TABLE=incentive/incentive_active_city
# Reference table behind the "add city" name autocomplete
DB_CITY_MAPPING_TABLE=mafsho/city_mapping

weather_ENDPOINT=http://172.21.88.66:5000/severity-forecast

# Backend logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Microsoft Teams incoming-webhook URL used to post notifications.
# Leave empty to disable.
TEAMS_WEBHOOK_URL=